# ─── LeetCode AI Agent (Next.js Fullstack) Configuration ───
# Copy this file to .env.local and fill in your values.

# Google Gemini API Key (Direct Google AI Studio - 100% Free - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=
NEXT_PUBLIC_GROQ_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
NEXT_PUBLIC_OPENROUTER_API_KEY=

# GitHub Personal Access Token (Optional: for committing/pushing AI chat sessions to your repo)
GITHUB_TOKEN=

