{
  "name": "leetcode-agent-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "LeetCode Agent root workspace scripts",
  "scripts": {
    "start": "npm --prefix nextjs run dev",
    "dev:next": "npm --prefix nextjs run dev",
    "build:next": "npm --prefix nextjs run build",
    "start:next": "npm --prefix nextjs start",
    "dev": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "backend": "backend\\.venv\\Scripts\\uvicorn.exe app.main:app --reload --port 8000 --app-dir backend",
    "build": "npm --prefix frontend run build"
  }
}
